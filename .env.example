# Copy to backend/.env (or export) to override defaults.
# All variables use the AGENTIC_ prefix and are read by the backend.

# SQLite database directory. The database lives at <data_dir>/agentic.db.
# Default: ~/.agentic
# AGENTIC_DATA_DIR=~/.agentic

# Full database URL; overrides AGENTIC_DATA_DIR when set.
# Default: sqlite:///<data_dir>/agentic.db
# AGENTIC_DATABASE_URL=

# Agent-run queue (SAQ). Defaults to a SQLite queue at <data_dir>/queue.db, so a
# worker needs no external service. Use a redis:// or postgres:// URL to share
# the queue across machines.
# AGENTIC_QUEUE_URL=sqlite:////home/you/.agentic/queue.db

# How many agent runs a worker processes concurrently (default 4).
# AGENTIC_WORKER_CONCURRENCY=4

# How often (seconds) a worker sweeps for stuck jobs (a dead worker's run).
# AGENTIC_WORKER_SWEEP=60

# Per-run job limits: timeout in seconds (0 disables it), heartbeat in seconds
# (how long a job may go untouched before a sweep retries it), and retries.
# AGENTIC_JOB_TIMEOUT=0
# AGENTIC_JOB_HEARTBEAT=120
# AGENTIC_JOB_RETRIES=1

# Where git worktrees are created for tasks.
# Default: ~/.agentic/worktrees
# AGENTIC_WORKTREE_ROOT=~/.agentic/worktrees

# Root the repository picker may browse. Use / to allow browsing anywhere.
# Default: ~
# AGENTIC_FS_ROOT=~

# Markdown notes tree holding the colleague-decisions reports the Decisions page
# reads (decisions/YYYY/MM/DD.md). The skill's own NOTES_DIR name is accepted
# too. Read-only. Default: ~/notes
# AGENTIC_NOTES_DIR=~/notes

# Built SPA to serve. Default: backend/static
# AGENTIC_STATIC_DIR=backend/static

# CORS origins for the Vite dev server.
# Default: ["http://localhost:5173", "http://127.0.0.1:5173"]
# AGENTIC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Harness used when a task does not pick one.
# Default: opencode
# AGENTIC_DEFAULT_HARNESS=opencode

# The GitHub login that counts as "you": a merged PR this account authored and a
# task links is recorded as a change automatically, and the inbox and a
# repository's pull requests only offer to record a change for the same PRs.
# Empty auto-detects the authenticated gh account.
# AGENTIC_GITHUB_LOGIN=tomzx

# Auto-approve ACP permission requests (single-user local tool).
# Default: true
# AGENTIC_AUTO_APPROVE_PERMISSIONS=true

# Base URL for "Open in OpenChamber" links. Default: unset
# AGENTIC_OPENCHAMBER_URL=http://localhost:3001

# Path appended to the OpenChamber base. Default: /?session={session}
# AGENTIC_OPENCHAMBER_SESSION_PATH=/?session={session}

# URL template for "Open in terminal" links. Placeholders: {session} {cwd} {harness}
# Default: unset
# AGENTIC_TERMINAL_URL_TEMPLATE=opencode://session/{session}

# URL template for the worktree "Open in editor" button. Placeholder: {path}
# Default: unset
# AGENTIC_EDITOR_URL_TEMPLATE=vscode://file{path}

# Base URLs of the ghx and slackx web UIs (`ghx serve` / `slackx serve`). When
# set, GitHub and Slack items link into that tool's UI. A managed transport
# supplies them, since the server runs those UIs itself. Default: unset
# AGENTIC_GHX_URL=http://localhost:8080
# AGENTIC_SLACKX_URL=http://localhost:8280

# Slack credentials for the item view's poke action: a reviewer's review is
# requested with a Slack DM. Read under the same names slackx uses, so one
# configuration serves both. A bot token (xoxb-) only needs SLACK_TOKEN; a web
# token (xoxc-) also needs its xoxd- cookie. Empty disables poking.
# SLACK_TOKEN=
# SLACK_COOKIE=

# Bot token used to post event notifications as a bot instead of as you. Set
# SLACK_BOT_TOKEN (xoxb-) to make notifications come from the bot; leave it
# unset to fall back to SLACK_TOKEN. SLACK_BOT_COOKIE is only needed for an
# xoxc- web token.
# SLACK_BOT_TOKEN=
# SLACK_BOT_COOKIE=

# Where event notifications are delivered when no recipient is given per call.
# Accepts a Slack user id (U...) or channel id/name. Also settable under
# Settings -> Slack.
# SLACK_USER_ID=
# SLACK_EVENTS_USER_ID=
# SLACK_EVENTS_CHANNEL=
# SLACK_NOTIFY_USER_ID=

# When to re-fetch Slack threads (slackx) and GitHub issues/PRs (ghx), each as
# comma-separated age=interval bands with an optional * fallback. Empty disables
# automatic refresh for that source. Default: unset
# AGENTIC_SLACK_REFRESH_POLICY=1d=1h,7d=6h,30d=1d,*=7d
# AGENTIC_GITHUB_REFRESH_POLICY=1d=1h,7d=6h,30d=1d,*=7d

# How the server runs the ghx and slackx helper CLIs: "cli" spawns the binary
# per call (default), "rpc" calls the tool's own JSON-RPC server instead (start
# one with `ghx rpc serve` / `slackx rpc serve`); mapped reads go through the
# server's typed methods and answer in-process, the rest through cli.run. A
# token is only needed when a server is bound beyond loopback. "managed" starts
# the tool's serve process from this server and supplies both its endpoint and
# its web UI URL. All six are also editable under Settings → Local tools, where
# a change applies without a restart.
# AGENTIC_GHX_BACKEND=cli
# AGENTIC_GHX_RPC_URL=http://127.0.0.1:8090
# AGENTIC_GHX_RPC_TOKEN=
# AGENTIC_SLACKX_BACKEND=cli
# AGENTIC_SLACKX_RPC_URL=http://127.0.0.1:8280
# AGENTIC_SLACKX_RPC_TOKEN=
# AGENTIC_RPC_TOKEN=
# AGENTIC_RPC_ALLOW_EXEC=true

# Seconds between checks for items due a refresh (0 disables the loop).
# Default: 300
# AGENTIC_ITEM_REFRESH_TICK=300

# Seconds between checks for scheduled shell tasks that are due (0 disables the
# loop), and how long one may run before it is stopped and marked failed.
# Defaults: 30 and 3600
# AGENTIC_SCHEDULED_TASK_TICK=30
# AGENTIC_SCHEDULED_TASK_TIMEOUT=3600

# The review scan: how often the API asks GitHub which pull requests await your
# review (a duration such as 1h or 30m; blank disables it), how often it checks
# whether the scan is due, what a repository with no policy of its own does
# (include or exclude), how many results each search returns, and the logins to
# leave out. The review SLO flags a pull request in the inbox once it has awaited
# your review longer than that (a duration such as 8h or 1d; blank disables it).
# The review nudge SLO flags one of your own pull requests once it has waited
# that long without any review from anyone (a duration such as 1h30m or 1d;
# blank disables it).
# Defaults: 1h, 300, include, 100, dependabot[bot], (no SLO), (no nudge SLO)
# AGENTIC_REVIEW_SCAN_INTERVAL=1h
# AGENTIC_REVIEW_SCAN_TICK=300
# AGENTIC_REVIEW_SCAN_DEFAULT=include
# AGENTIC_REVIEW_SCAN_LIMIT=100
# AGENTIC_REVIEW_SCAN_EXCLUDE_AUTHORS=dependabot[bot]
# AGENTIC_REVIEW_SLO=1d
# AGENTIC_REVIEW_NUDGE_SLO=1d
