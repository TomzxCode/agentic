// Generated by /sync-sdlc on 2026-10-26 from backend/src/agentic/models/ and the
// in-place migration helpers in backend/src/agentic/db.py (_migrate_*, _ensure_columns).
// The ER overview lives in architecture.md; this file is the detailed schema.
// SQLite; PRAGMA journal_mode=WAL, synchronous=NORMAL and foreign_keys=ON.

Table task {
  id varchar [pk]
  title varchar [not null]
  description text [not null, default: '']
  status varchar [not null, default: 'open'] // open | in_progress | blocked | done | archived
  priority integer [not null, default: 2] // 0 low, 1 medium, 2 high, 3 urgent
  tags json [not null]
  group_id varchar [ref: > repositorygroup.id]
  harness_id varchar [ref: > harness.id]
  deadline datetime // when the task should be done by; null = no deadline
  waiting_on_person_id varchar [ref: > person.id] // who the task waits on; parks it off the stack
  follow_up_at datetime // when to check back with that person; null = until cleared
  snoozed_until datetime // when the task rejoins the stack; a past date has no effect
  summary text [not null, default: '']
  next_steps json [not null]
  context_updated_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]

  // Legacy column: the old single repository_id is left in place (SQLite cannot
  // drop a FK column) but emptied by _migrate_task_repositories(); superseded by
  // task_repository.
  // repository_id varchar

  Indexes {
    group_id
    harness_id
  }
}

// A directed before/after edge between two tasks. before_id must be done
// before after_id; adding an edge that would close a cycle is refused.
Table taskdependency {
  id varchar [pk]
  before_id varchar [not null, ref: > task.id]
  after_id varchar [not null, ref: > task.id]
  created_at datetime [not null]

  Indexes {
    before_id
    after_id
    (before_id, after_id) [unique, name: 'uq_dependency_edge']
  }
}

// A symmetric "related" link between two tasks. The pair is stored once with
// the ids ordered, so it reads the same from either task and never joins the
// before/after dependency graph.
Table taskrelation {
  id varchar [pk]
  task_id varchar [not null, ref: > task.id]
  related_id varchar [not null, ref: > task.id]
  created_at datetime [not null]

  Indexes {
    task_id
    related_id
    (task_id, related_id) [unique, name: 'uq_related_pair']
  }
}

Table sourceitem {
  id varchar [pk]
  source varchar // slack | github | gdrive | url | note | commit | file
  kind varchar [not null, default: ''] // thread | issue | pr | doc | ...
  title varchar [not null, default: '']
  title_custom boolean [not null, default: false] // a person set it; a refresh leaves it alone
  url varchar
  external_id varchar
  metadata_json json [not null]
  content text [not null, default: '']
  done_at datetime // a Slack thread a person marked done
  done_message_ts varchar // newest Slack message when it was marked done
  fetched_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]

  Indexes {
    (source, external_id) [unique, name: 'uq_source_external_id']
  }
}

Table association {
  id varchar [pk]
  task_id varchar [not null, ref: > task.id]
  item_id varchar [not null, ref: > sourceitem.id]
  note text [not null, default: '']
  created_at datetime [not null]

  Indexes {
    task_id
    item_id
  }
}

Table repository {
  id varchar [pk]
  name varchar [not null]
  path varchar [not null]
  remote_url varchar
  default_branch varchar
  review_scan varchar [not null, default: 'default'] // default | include | exclude; whether the scan considers its pull requests
  created_at datetime [not null]
}

Table repositorygroup {
  id varchar [pk]
  name varchar [not null]
  description text [not null, default: '']
  created_at datetime [not null]
}

Table repositorygroupmember {
  id varchar [pk]
  group_id varchar [not null, ref: > repositorygroup.id]
  repository_id varchar [not null, ref: > repository.id]
  created_at datetime [not null]

  Indexes {
    group_id
    repository_id
    (group_id, repository_id) [unique, name: 'uq_group_repository']
  }
}

Table taskrepository {
  id varchar [pk]
  task_id varchar [not null, ref: > task.id]
  repository_id varchar [not null, ref: > repository.id]
  created_at datetime [not null]

  Indexes {
    task_id
    repository_id
    (task_id, repository_id) [unique, name: 'uq_task_repository']
  }
}

Table person {
  id varchar [pk]
  name varchar [not null] // not unique; identity is the id plus aliases
  notes text [not null, default: '']
  created_at datetime [not null]
  updated_at datetime [not null]

  // Legacy columns: the old single handle and email are left in place (SQLite
  // column drops are disruptive) but emptied by _migrate_person_aliases();
  // superseded by personalias. A fresh database never has them.
  // handle varchar
  // email varchar
}

// An identifier for a person: a handle (GitHub login, Slack user id) or an
// email. The value is what de-duplicates people across sources.
Table personalias {
  id varchar [pk]
  person_id varchar [not null, ref: > person.id]
  value varchar [not null]
  created_at datetime [not null]

  Indexes {
    person_id
    value
    (person_id, value) [unique, name: 'uq_person_alias']
  }
}

Table taskperson {
  id varchar [pk]
  task_id varchar [not null, ref: > task.id]
  person_id varchar [not null, ref: > person.id]
  created_at datetime [not null]

  Indexes {
    task_id
    person_id
    (task_id, person_id) [unique, name: 'uq_task_person']
  }
}

// The people who requested a task, a link set separate from taskperson (the
// people it involves).
Table taskrequester {
  id varchar [pk]
  task_id varchar [not null, ref: > task.id]
  person_id varchar [not null, ref: > person.id]
  created_at datetime [not null]

  Indexes {
    task_id
    person_id
    (task_id, person_id) [unique, name: 'uq_task_requester']
  }
}

Table itemperson {
  id varchar [pk]
  item_id varchar [not null, ref: > sourceitem.id]
  person_id varchar [not null, ref: > person.id]
  created_at datetime [not null]

  Indexes {
    item_id
    person_id
    (item_id, person_id) [unique, name: 'uq_item_person']
  }
}

Table worktree {
  id varchar [pk]
  task_id varchar [not null, ref: > task.id]
  repository_id varchar [not null, ref: > repository.id]
  branch varchar [not null]
  path varchar [not null]
  status varchar [not null, default: 'active'] // active | removed
  created_at datetime [not null]
  removed_at datetime

  Indexes {
    task_id
  }
}

Table harness {
  id varchar [pk]
  name varchar [not null]
  description text [not null, default: '']
  command varchar [not null]
  args json [not null]
  env json [not null]
  model varchar
  default_model_source varchar // where the harness's own default model is read from, "<json file>#<template>"
  resume_command varchar // resume template, e.g. "opencode --session {session}"; placeholders {session} {cwd} {harness}
  is_default boolean [not null, default: false]
  created_at datetime [not null]
}

Table setting {
  key varchar [pk]
  value text [not null, default: '']
  updated_at datetime [not null]
}

Table agentrun {
  id varchar [pk]
  task_id varchar [not null, ref: > task.id]
  harness_id varchar [ref: > harness.id]
  cwd varchar
  worktree_id varchar [ref: > worktree.id]
  prompt text [not null, default: '']
  kind varchar [not null, default: 'chat'] // chat | refresh_context
  status varchar [not null, default: 'queued'] // queued | running | succeeded | failed | cancelled
  session_id varchar // the ACP session id
  model varchar // the model the run's session answers with, from the ACP session config
  model_name varchar // the harness's own label for that model
  requested_model varchar // the model this run asked for; overrides the harness model for this run only
  // Plain ids, not foreign keys: deleting a graph keeps its past runs.
  graph_execution_id varchar
  graph_node_id varchar
  stop_reason varchar
  error text
  created_at datetime [not null]
  started_at datetime
  ended_at datetime

  Indexes {
    task_id
    graph_execution_id
  }
}

Table agentevent {
  id integer [pk, increment]
  run_id varchar [not null, ref: > agentrun.id]
  seq integer [not null, default: 0]
  type varchar [not null, default: 'info'] // message | thought | tool_call | tool_update | plan | usage | model | status | error
  text text [not null, default: '']
  data_json json [not null]
  created_at datetime [not null]

  Indexes {
    run_id
  }
}

// An agent session attached by hand (for example one started in OpenChamber);
// a run's own session lives on the agentrun row.
Table agentsession {
  id varchar [pk]
  task_id varchar [not null, ref: > task.id]
  harness_id varchar [ref: > harness.id]
  session_id varchar [not null] // the ACP (or agent) session id
  label varchar [not null, default: '']
  cwd varchar
  created_at datetime [not null]

  Indexes {
    task_id
  }
}

Table timelineevent {
  id varchar [pk]
  task_id varchar [not null, ref: > task.id]
  type varchar [not null]
  message text [not null, default: '']
  data_json json [not null]
  client varchar [not null, default: 'api'] // web | cli | api
  actor varchar [not null, default: 'human'] // human | agent
  created_at datetime [not null]

  Indexes {
    task_id
  }
}

Table change {
  id varchar [pk]
  task_id varchar [not null, ref: > task.id]
  title varchar [not null, default: '']
  change_class varchar [not null, default: 'feature'] // feature | bugfix | refactor | chore | docs | test | trivial
  status varchar [not null, default: 'proposed'] // proposed | verified | accepted | rejected | reverted
  repository_id varchar [ref: > repository.id]
  worktree_id varchar [ref: > worktree.id]
  external_ref varchar
  human_intervened boolean [not null, default: false]
  intervention_count integer [not null, default: 0]
  opened_at datetime [not null]
  verified_at datetime
  accepted_at datetime
  closed_at datetime
  notes text [not null, default: '']
  created_at datetime [not null]
  updated_at datetime [not null]

  Indexes {
    task_id
    status
    accepted_at
  }
}

Table changeintervention {
  id varchar [pk]
  change_id varchar [not null, ref: > change.id]
  kind varchar [not null, default: 'other'] // question | correction | manual_fix | rerun | approval | other
  note text [not null, default: '']
  created_at datetime [not null]

  Indexes {
    change_id
  }
}

Table metricbaseline {
  metric varchar [pk] // autonomy_rate | yield
  value float [not null]
  window_days integer [not null, default: 30]
  observation_days integer [not null, default: 14]
  note text [not null, default: '']
  captured_at datetime [not null]
}

Table stackentry {
  id varchar [pk]
  task_id varchar [not null, ref: > task.id]
  position integer [not null, default: 0] // 0 is the current task
  is_current boolean [not null, default: false]
  created_at datetime [not null]
  deleted_at datetime // soft delete: popped or removed entries stay in history
  deleted_reason varchar // popped | removed | parked; a parked entry is restored when the deferral ends

  Indexes {
    task_id
    position
  }
}

Table tasksession {
  id varchar [pk]
  stack_entry_id varchar [not null, ref: > stackentry.id]
  started_at datetime [not null]
  ended_at datetime // null while the entry is current

  Indexes {
    stack_entry_id
  }
}

Table scheduledtask {
  id varchar [pk]
  name varchar [not null]
  command varchar [not null] // run with the shell, so pipes and && work as written
  cwd varchar // null runs in the server's own directory
  schedule varchar [not null] // 5-field cron expression
  timezone varchar // IANA zone; null uses the server's timezone
  enabled boolean [not null, default: true]
  last_run_at datetime
  next_run_at datetime // recomputed on create, edit, and run so an occurrence never fires twice
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table scheduledtaskrun {
  id varchar [pk]
  scheduled_task_id varchar [not null, ref: > scheduledtask.id]
  status varchar [not null, default: 'running'] // running | succeeded | failed
  exit_code integer
  output text [not null, default: ''] // combined stdout and stderr, truncated to a readable tail
  started_at datetime [not null]
  ended_at datetime

  Indexes {
    scheduled_task_id
  }
}

// An execution graph: nodes and edges have no tables of their own, the
// definition column holds them as JSON.
Table executiongraph {
  id varchar [pk]
  name varchar [not null]
  description text [not null, default: '']
  schedule varchar // 5-field cron; null runs only when asked
  timezone varchar // IANA zone; null uses the server's timezone
  enabled boolean [not null, default: true]
  definition json [not null] // {"nodes": [...], "edges": [...]}
  next_run_at datetime // recomputed on create, edit, and fire so an occurrence never triggers twice
  last_run_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table graphexecution {
  id varchar [pk]
  graph_id varchar [not null, ref: > executiongraph.id]
  task_id varchar [not null, ref: > task.id] // the task every run node attaches to
  trigger varchar [not null, default: 'manual'] // manual | schedule
  status varchar [not null, default: 'running'] // running | succeeded | failed | cancelled
  error text [not null, default: '']
  state json [not null] // node statuses, run outputs, form answers
  started_at datetime [not null]
  ended_at datetime

  Indexes {
    graph_id
    task_id
  }
}

// A pull request the review scan found awaiting the user's feedback. GitHub is
// the source of truth: every scan replaces this set, so a row exists only while
// the pull request still awaits a review.
Table reviewrequest {
  id varchar [pk]
  repository varchar [not null] // "owner/name", in GitHub's own casing
  number integer [not null]
  source varchar [not null, default: 'requested'] // requested | reviewed
  title varchar [not null, default: '']
  url varchar [not null, default: '']
  author varchar [not null, default: '']
  state varchar [not null, default: ''] // GitHub's own state
  draft boolean [not null, default: false]
  created_at varchar // GitHub's creation time, carried as text
  first_seen_at datetime [not null] // survives across scans
  updated_at datetime [not null]

  Indexes {
    repository
    (repository, number) [unique, name: 'uq_review_request']
  }
}
